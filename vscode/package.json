{
  "name": "graphtrail-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "leegyeongpil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeGyeongPil/graphtrail.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Debuggers", "Visualization", "Other"],
  "keywords": ["langgraph", "checkpoint", "sqlite", "agent", "debugging"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "graphtrail.language": {
          "type": "string",
          "enum": ["auto", "en", "ko"],
          "enumDescriptions": ["%config.language.auto%", "%config.language.en%", "%config.language.ko%"],
          "default": "auto",
          "description": "%config.language.description%"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "graphtrail.checkpointDb",
        "displayName": "%customEditor.displayName%",
        "selector": [
          { "filenamePattern": "*.sqlite" },
          { "filenamePattern": "*.sqlite3" },
          { "filenamePattern": "*.db" }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "graphtrail.threads",
          "name": "%view.threads.name%",
          "when": "graphtrail.hasDatabase"
        }
      ]
    },
    "commands": [
      {
        "command": "graphtrail.openDatabase",
        "title": "%command.openDatabase.title%"
      },
      {
        "command": "graphtrail.showThread",
        "title": "%command.showThread.title%"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "graphtrail.showThread", "when": "false" }
      ]
    }
  }
}
