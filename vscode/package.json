{
  "name": "graphtrail-vscode",
  "displayName": "graphtrail - LangGraph checkpoint viewer",
  "description": "Open a LangGraph SqliteSaver database read-only: thread timeline, state diffs and tool calls, without running any code.",
  "version": "0.1.3",
  "publisher": "leegyeongpil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeeGyeongPil/graphtrail.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Debuggers", "Visualization", "Other"],
  "keywords": ["langgraph", "checkpoint", "sqlite", "agent", "debugging"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "graphtrail.checkpointDb",
        "displayName": "graphtrail checkpoint viewer",
        "selector": [
          { "filenamePattern": "*.sqlite" },
          { "filenamePattern": "*.sqlite3" },
          { "filenamePattern": "*.db" }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "graphtrail.threads",
          "name": "graphtrail threads",
          "when": "graphtrail.hasDatabase"
        }
      ]
    },
    "commands": [
      {
        "command": "graphtrail.openDatabase",
        "title": "graphtrail: Open Checkpoint Database"
      },
      {
        "command": "graphtrail.showThread",
        "title": "graphtrail: Show Thread"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "graphtrail.showThread", "when": "false" }
      ]
    }
  }
}
