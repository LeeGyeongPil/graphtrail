{
  "name": "graphtrail",
  "version": "0.1.0",
  "description": "LangGraph checkpoint viewer: read a SqliteSaver database without running any code, rebuild the run timeline and diff states.",
  "keywords": ["langgraph", "checkpoint", "sqlite", "msgpack", "debugging", "agent", "cli"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/LeeGyeongPil/graphtrail.git" },
  "homepage": "https://github.com/LeeGyeongPil/graphtrail#readme",
  "bugs": { "url": "https://github.com/LeeGyeongPil/graphtrail/issues" },
  "author": "LeeGyeongPil",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "graphtrail": "dist/cli.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/format.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "npm run build && node --test --test-reporter=spec \"test/*.test.ts\"",
    "vsix": "tsc -p vscode/tsconfig.json && node vscode/build.mjs && node vscode/package-vsix.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/sql.js": "1.4.11",
    "@types/vscode": "1.145.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
